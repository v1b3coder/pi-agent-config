{
  "lastChangelogVersion": "0.87.1",
  "defaultProvider": "litellm",
  "defaultModel": "deepseek-ai/DeepSeek-V4-Flash",
  "compaction": {
    "enabled": true,
    "reserveTokens": 40960,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 10000,
    "baseDelayMs": 5000,
    "maxAgentDelayMs": 1800000
  },
  "packages": [
    {
      "source": "npm:pi-skill-tavily",
      "skills": [
        "skills/tavily-research/SKILL.md",
        "skills/tavily-search/SKILL.md",
        "skills/tavily-extract/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-amplike",
      "extensions": [
        "extensions/handoff.ts",
        "!extensions/modes.ts",
        "!extensions/session-query.ts"
      ],
      "skills": []
    },
    "npm:pi-footer",
    "npm:pi-mcp-adapter",
    "!npm:pi-agentic-compaction",
    "!npm:pi-openplan",
    "npm:pi-interactive-shell",
    "npm:@dreki-gg/pi-context7"
  ],
  "pi-agentic-compaction": {
    "models": [
      "deepseek-ai/DeepSeek-V4-Flash"
    ]
  },
  "env": {
    "PI_EXT_NTFY_TAGS": "robot",
    "PI_EXT_NTFY_TIMEOUT_MS": 60000
  },
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "transport": "auto",
  "hideThinkingBlock": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "enabledModels": [
    "litellm/**"
  ],
  "theme": "dark",
  "showHardwareCursor": true,
  "outputPad": 0,
  "steeringMode": "all",
  "followUpMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "treeFilterMode": "default",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "tuiMode": "regular",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto"
}