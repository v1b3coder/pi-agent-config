{
  "lastChangelogVersion": "0.84.2",
  "defaultProvider": "litellm",
  "defaultModel": "zai-org/GLM-5.3-Flash",
  "compaction": {
    "enabled": true,
    "reserveTokens": 40960,
    "keepRecentTokens": 20000
  },
  "packages": [
    {
      "source": "npm:pi-skill-tavily",
      "skills": [
        "skills/tavily-research/SKILL.md",
        "skills/tavily-search/SKILL.md",
        "skills/tavily-extract/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-amplike",
      "extensions": [
        "extensions/btw.ts",
        "extensions/handoff.ts",
        "extensions/modes.ts",
        "extensions/session-query.ts"
      ],
      "skills": []
    },
    "npm:pi-footer",
    "npm:pi-mcp-adapter",
    "npm:pi-agentic-compaction",
    "npm:pi-openplan",
    "npm:pi-interactive-shell",
    "npm:@dreki-gg/pi-context7"
  ],
  "pi-agentic-compaction": {
    "models": [
      "deepseek-ai/DeepSeek-V4-Flash"
    ]
  },
  "env": {
    "PI_EXT_NTFY_TAGS": "robot",
    "PI_EXT_NTFY_TIMEOUT_MS": 60000
  },
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "transport": "auto",
  "hideThinkingBlock": true,
  "collapseChangelog": false,
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "enabledModels": [
    "litellm/beast/big",
    "litellm/beast/small",
    "litellm/Qwen/Qwen3.6-27B-FP8",
    "litellm/morosystems/ThinkingCap-Qwen3.6-27B-NVFP4",
    "litellm/deepseek-ai/DeepSeek-V4-Flash",
    "litellm/zai-org/GLM-5.3-Flash"
  ],
  "theme": "dark"
}
