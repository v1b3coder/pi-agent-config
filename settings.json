{
  "lastChangelogVersion": "0.78.0",
  "defaultProvider": "litellm",
  "defaultModel": "deepseek-ai/DeepSeek-V4-Flash",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "packages": [
    {
      "source": "npm:pi-provider-litellm",
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:pi-skill-tavily",
    {
      "source": "npm:pi-amplike",
      "extensions": [
        "extensions/btw.ts",
        "extensions/handoff.ts",
        "extensions/modes.ts",
        "extensions/session-query.ts"
      ],
      "skills": [
        "-skills/web-search/SKILL.md",
        "-skills/visit-webpage/SKILL.md"
      ]
    },
    "npm:pi-footer",
    "npm:pi-subagents",
    "npm:pi-goal-x",
    "npm:pi-mcp-adapter",
    "npm:pi-agentic-compaction"
  ],
  "pi-agentic-compaction": {
    "models": [
      "deepseek-ai/DeepSeek-V4-Flash"
    ]
  },
  "env": {
    "TAVILY_API_KEY": "tvly-dev-REMOVED",
    "PI_EXT_NTFY_ENABLED": 1,
    "PI_EXT_NTFY_TOPIC": "ntfy-topic-removed",
    "PI_EXT_NTFY_TAGS": "robot",
    "PI_EXT_NTFY_TIMEOUT_MS": 60000
  },
  "defaultThinkingLevel": "medium",
  "showHardwareCursor": false,
  "enableInstallTelemetry": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "hideThinkingBlock": false,
  "collapseChangelog": false,
  "quietStartup": false,
  "doubleEscapeAction": "tree"
}