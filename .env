# Copy this file to .env.local and set proper values there
LITELLM_BASE_URL="" # Beast URL
LITELLM_API_KEY="" # Beast API key
TAVILY_API_KEY="" # Enables web search
PI_EXT_NTFY_ENABLED=0 # Enable ntfy notifications to mobile phone
PI_EXT_NTFY_TOPIC="" # Any random enough value to have unique ntfy channel

# Per-turn output cap (maxTokens) for vLLM-style routes behind this proxy (default 65536).
# vLLM mirrors its combined input+output budget into max_output_tokens, which made
# pi request ~all remaining context and hard-fail (400) on large sessions.
# Leave commented for the default, or set any positive number.
#LITELLM_MAX_VLLM_OUTPUT_TOKENS=65536
